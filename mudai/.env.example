# Geral
NODE_ENV=production
GATEWAY_PORT=10233
MAX_UPLOAD_MB=20
PORT=4000

# Storage local (volume Docker) — guarda catálogo e fotos enviadas
STORAGE_DIR=/data/storage

# IA — camada compatível com OpenAI (Command Code, OpenAI, LiteLLM, Ollama...)
AI_BASE_URL=https://api.commandcode.ai/provider/v1
AI_API_KEY=trocar
AI_CHAT_MODEL=deepseek/deepseek-v4-flash-vision-exp
AI_CHAT_FALLBACK=deepseek/deepseek-v4-flash
AI_VISION_MODEL=deepseek/deepseek-v4-flash-vision-exp
AI_VISION_FALLBACK=deepseek/deepseek-v4-flash

# Senha do painel /admin de cadastro de plantas
ADMIN_TOKEN=trocar-por-uma-senha-forte
