# Geral
NODE_ENV=production
GATEWAY_PORT=10233
MAX_UPLOAD_MB=20
PORT=4000

# Banco / cache (internos, sem porta publicada)
DB_NAME=mudai
DB_USER=mudai
DB_PASSWORD=trocar
DATABASE_URL=postgresql://mudai:trocar@db:5432/mudai
REDIS_URL=redis://redis:6379

# Storage local (volume Docker)
STORAGE_DIR=/data/storage

# IA — camada compatível com OpenAI (Command Code, OpenAI, LiteLLM, Ollama...)
AI_BASE_URL=https://api.commandcode.ai/provider/v1
AI_API_KEY=trocar
AI_CHAT_MODEL=deepseek/deepseek-v4-flash
AI_CHAT_FALLBACK=deepseek/deepseek-v4-pro
AI_VISION_MODEL=deepseek/deepseek-v4-flash-vision-exp
AI_VISION_FALLBACK=deepseek/deepseek-v4-flash
