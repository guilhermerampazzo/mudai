{
  "name": "mudai-server",
  "version": "1.0.0",
  "private": true,
  "description": "API do Mudaí — catálogo de plantas, identificação por IA e chat Hachimi",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json && node -e \"require('fs').cpSync('src/dados','dist/dados',{recursive:true})\"",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/multipart": "^10.1.1",
    "@fastify/static": "^10.1.3",
    "fastify": "^5.12.3",
    "sharp": "^0.35.4",
    "zod": "^4.6.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3"
  }
}
