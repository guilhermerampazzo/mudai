generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Plant {
  id           String   @id @default(uuid())
  slug         String   @unique
  nomePopular  String
  nomeCientifico String
  descricao    String
  svg          String
  aguaNivel    Int
  aguaFreqDias Int
  luxMin       Int
  luxMax       Int
  tempMin      Int
  tempMax      Int
  umidadeMin   Int
  umidadeMax   Int
  dificuldade  Int
  porte        String
  toxicaPets   Boolean  @default(false)
  tags         String[]
  cuidados     Json
  sinais       Json
  curiosidades String[]
  createdAt    DateTime @default(now())
  pets         Pet[]
}

model Pet {
  id        String   @id @default(uuid())
  apelido   String
  foto      String?
  local     String
  plantId   String?
  plant     Plant?   @relation(fields: [plantId], references: [id])
  especieLivrenome String?
  ultimaRega DateTime?
  ultimoLux  Int?
  leituras  LuxReading[]
  createdAt DateTime @default(now())
}

model LuxReading {
  id        String   @id @default(uuid())
  petId     String?
  pet       Pet?     @relation(fields: [petId], references: [id], onDelete: Cascade)
  valor     Int
  createdAt DateTime @default(now())
}

model Identification {
  id         String   @id @default(uuid())
  imageHash  String   @unique
  plantSlug  String?
  confianca  Float
  ficha      Json?
  createdAt  DateTime @default(now())
}

model ChatMessage {
  id        String   @id @default(uuid())
  sessao    String
  role      String
  conteudo  String
  createdAt DateTime @default(now())
}
